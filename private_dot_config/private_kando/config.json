{
  "version": "3.0.0",
  "locale": "auto",
  "showIntroductionDialog": false,
  "menuTheme": "rainbow-labels",
  "darkMenuTheme": "rainbow-labels",
  "menuThemeColors": {
    "clean-circle": {
      "action-icon-color": "rgba(255, 200, 225, 1)"
    },
    "rainbow-labels": {
      "icon-color": "rgb(56 56 56)",
      "label-background-color": "rgb(255 255 255)",
      "label-color": "rgb(36 36 36)"
    }
  },
  "darkMenuThemeColors": {},
  "enableDarkModeForMenuThemes": true,
  "enableSelectionWedges": false,
  "underlineQuickSelectKey": true,
  "drawQuickSelectKey": false,
  "fadeInDuration": 100,
  "fadeOutDuration": 100,
  "enableMenuAnimations": true,
  "enablePointerReactiveEffects": true,
  "soundTheme": "none",
  "soundVolume": 0.5,
  "enableVersionCheck": false,
  "ignoreWriteProtectedConfigFiles": false,
  "settingsWindowColorScheme": "system",
  "settingsWindowFlavor": "sakura-system",
  "trayIconFlavor": "color",
  "hardwareAcceleration": true,
  "lazyInitialization": false,
  "zoomFactor": 1,
  "hideSettingsButton": true,
  "settingsButtonPosition": "bottom-right",
  "windowsInkWorkaround": true,
  "maxSelectionRadius": 0,
  "centerDeadZone": 50,
  "minParentDistance": 150,
  "dragThreshold": 15,
  "keepInputFocus": false,
  "hideOnFocusOut": true,
  "enableMarkingMode": true,
  "enableTurboMode": true,
  "warpMouse": true,
  "returnPointerToMenuOpeningPosition": false,
  "hoverModeNeedsConfirmation": false,
  "triggerCenterClickOnKeyRelease": false,
  "gestureMinStrokeLength": 150,
  "gestureMinStrokeAngle": 20,
  "gestureJitterThreshold": 10,
  "gesturePauseTimeout": 100,
  "fixedStrokeLength": 0,
  "rmbSelectsParent": false,
  "enableGamepad": true,
  "gamepadBackButton": 1,
  "gamepadCloseButton": 2,
  "sameShortcutBehavior": "nothing",
  "wlrootsPointerGetTimeoutMouse": 500,
  "wlrootsPointerGetTimeoutTouch": 1500,
  "wlrootsPointerGetTimeoutDefaultBehavior": "center",
  "useDefaultOsShowSettingsHotkey": true,
  "enableAchievements": true,
  "enableAchievementNotifications": true
}
