export ZSH="$HOME/.oh-my-zsh"
zstyle ':omz:update' mode auto
plugins=(git zsh-syntax-highlighting zsh-autosuggestions ohmyzsh-full-autoupdate)
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern regexp)
DISABLE_MAGIC_FUNCTIONS=true
DISABLE_LS_COLORS=true
HYPHEN_INSENSITIVE="true"

HISTSIZE=10000000
SAVEHIST=$HISTSIZE
setopt appendhistory sharehistory

source $ZSH/oh-my-zsh.sh

# Best tab complete
export CARAPACE_BRIDGES='zsh,bash'
export CARAPACE_ENV=0
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace zsh)

alias c="clear"
alias ls="eza"
alias cz="chezmoi"
# Preserve settings when running programs as sudo
# The space is important!!!
alias sudo='sudo -E env PATH=$PATH '
# More sane config file location
alias gdu="gdu --config-file ~/.config/gdu/config.yaml"
alias oc="opencode"
# Ctrl+Backspace: kill the word backward
bindkey -M emacs '^H' backward-kill-word
bindkey -M viins '^H' backward-kill-word
bindkey -M vicmd '^H' backward-kill-word

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

function neovide-remote() {
  local client="${1:?Error: SSH client name is required}"
  local target="${2:-$HOME}"

  nvrh client open "$client" --nvim-cmd ~/.local/bin/nvim --local-editor "neovide,--server,{{SOCKET_PATH}},--no-fork" "$target"
}

eval "$(atuin init zsh --disable-up-arrow)"
eval "$(oh-my-posh init zsh --config $HOME/.config/ohmyposh/mytheme.omp.toml)"
eval "$(zoxide init --cmd cd zsh)"
# Disable zoxide completion
compdef _cd cd
